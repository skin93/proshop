{
  "name": "proshop",
  "version": "1.0.0",
  "description": "MERN shopping cart app",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=12.8.4",
    "npm": ">=6.14.6"
  },
  "scripts": {
    "start": "node backend/server",
    "build": "npm install && cd frontend && yarn install && yarn build",
    "server": "nodemon backend/server",
    "client": "npm start ---prefix frontend",
    "dev": "concurrently \"npm run server \" \"npm run client \"",
    "data:import": "node backend/seeder",
    "data:destroy": "node backend/seeder -d"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skin93/proshop.git"
  },
  "author": "Arkadiusz Ciesielski",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/skin93/proshop/issues"
  },
  "homepage": "https://github.com/skin93/proshop#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "colors": "^1.4.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-async-handler": "^1.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "nodemon": "^3.1.14"
  }
}
